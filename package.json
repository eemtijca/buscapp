{
  "name": "buscapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @buscapp/web",
    "dev:web": "npm run dev -w @buscapp/web",
    "build": "run-p type-check build-only",
    "build-only": "npm run build-only -w @buscapp/web",
    "preview": "npm run preview -w @buscapp/web",
    "prepare": "node scripts/preparar-contratos.mjs",
    "type-check": "npm run build -w @buscapp/contratos && npm run type-check --workspaces --if-present",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli apps/web/src apps/api/src packages/contratos/src",
    "test": "run-s test:typecheck test:lint test:build test:unit",
    "test:e2e": "npx playwright test",
    "test:e2e:docker": "bash tests/playwright-container.sh",
    "test:e2e:docker:chromium": "bash tests/playwright-container.sh --project=chromium",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "capturas:readme": "playwright test tests/e2e/imagens.spec.ts",
    "capturas:readme:docker": "bash tests/playwright-container.sh tests/e2e/imagens.spec.ts",
    "test:pwa:run": "playwright test --config=playwright.pwa.config.ts",
    "test:pwa:docker": "TEST_BASE_URL=http://localhost:4173 bash tests/playwright-container.sh --config=playwright.pwa.config.ts --project=chromium",
    "test:db": "bash scripts/test-db.sh",
    "test:runtime:vercel": "node scripts/verificar-runtime-vercel.mjs",
    "test:typecheck": "run-s type-check",
    "test:lint": "run-s lint:*",
    "test:build": "run-s build-only",
    "dev:api": "npm run dev -w @buscapp/api",
    "db:generate": "npm run generate -w @buscapp/api",
    "db:migrate": "npm run migrate:deploy -w @buscapp/api",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "test:unit": "run-s test:unit:texto test:unit:api test:unit:web",
    "test:unit:texto": "vitest run tests/unit/texto-editorial.test.ts",
    "test:texto": "vitest run tests/unit/texto-editorial.test.ts",
    "versao:verificar": "node scripts/verificar-versao.mjs",
    "test:unit:api": "npm run test -w @buscapp/api",
    "test:unit:web": "npm run test -w @buscapp/web",
    "test:api": "npm run test -w @buscapp/api",
    "test:pwa": "VITE_API_URL=http://localhost:3001 run-s build-only test:pwa:run",
    "etiquetas:sync": "node scripts/sincronizar-etiquetas.mjs",
    "infra:fmt": "terraform fmt -recursive infra/terraform",
    "infra:validar": "bash infra/terraform/validar.sh",
    "infra:floci": "bash infra/floci/testar.sh",
    "infra:floci:aws": "bash infra/floci/testar.sh aws",
    "infra:floci:azure": "bash infra/floci/testar.sh azure",
    "infra:floci:gcp": "bash infra/floci/testar.sh gcp"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@vue/eslint-config-typescript": "^14.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.85.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.85.0",
    "pg": "^8.23.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
