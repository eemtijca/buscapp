# Banco de dados da API (PostgreSQL).
# Docker Compose (container app): postgresql://buscapp:buscapp@postgres:5432/buscapp
# Local apontando para o Postgres do Compose: postgresql://buscapp:buscapp@127.0.0.1:5433/buscapp
DATABASE_URL=postgresql://buscapp:buscapp@127.0.0.1:5433/buscapp

# Migrações em bancos gerenciados (opcional; ex.: pooler de sessão do provedor)
# DIRECT_URL=

# API
PORT=3001
HOST=0.0.0.0
APP_URL=http://localhost:5173
# Origens adicionais para CORS (separadas por vírgula)
APP_ORIGINS=
WEB_DIST=../web/dist

# Autenticação própria: pepper dos códigos de redefinição (mínimo 32 caracteres em produção)
AUTH_PEPPER=troque-por-um-segredo-longo-e-aleatorio

# Cookies de sessão
SESSAO_COOKIE=buscapp_sessao
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Armazenamento de anexos: disco (padrão) ou s3
STORAGE_DRIVER=disco
UPLOAD_DIR=uploads
# S3_BUCKET=buscapp-anexos
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Seed de desenvolvimento
SEED_SENHA_ADMIN=Admin123!
SEED_SENHA_PROF=Prof123!
SEED_SENHA_RESP=Resp123!
