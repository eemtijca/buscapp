{
  "name": "@buscapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/principal.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/principal.js",
    "type-check": "prisma generate && tsc --noEmit",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx prisma/seeds/dev.ts",
    "seed:prod": "node dist/prisma/seeds/dev.js"
  },
  "dependencies": {
    "@buscapp/contratos": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  },
  "dependencies/fastify": "^5.12.4",
  "fastify-type-provider-zod": "^7.0.0"
}
