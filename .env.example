# Banco de dados da API (PostgreSQL).
# Runtime usa o papel restrito `buscapp_api` (sujeito ao RLS); migrações usam o dono do schema.
# Em banco gerenciado atrás de pooler (ex.: Supabase), use o pooler de transação na
# DATABASE_URL (`:6543`, usuário `buscapp_api.<ref>`) e a conexão de sessão/direta na
# MIGRATE_DATABASE_URL, que também é usada pelo cliente administrativo da API.
# Docker Compose (container app):
#   DATABASE_URL=postgresql://buscapp_api:buscapp_api@postgres:5432/buscapp
#   MIGRATE_DATABASE_URL=postgresql://buscapp:buscapp@postgres:5432/buscapp
DATABASE_URL=postgresql://buscapp_api:buscapp_api@127.0.0.1:5433/buscapp
MIGRATE_DATABASE_URL=postgresql://buscapp:buscapp@127.0.0.1:5433/buscapp

# Fixtures/limpeza dos testes (dono do schema, bypassa RLS; nunca use no runtime)
DATABASE_URL_ADMIN=postgresql://buscapp:buscapp@127.0.0.1:5433/buscapp

# Senha do papel de runtime, aplicada pelo entrypoint do Compose e pelo workflow
# `migracoes.yml` em produção (secret APP_DB_PASSWORD_PROD).
APP_DB_PASSWORD=buscapp_api

# API
PORT=3001
HOST=0.0.0.0
# Fuso horário da escola usado no horário protegido do chat e nas datas civis.
TZ_ESCOLA=America/Sao_Paulo
# Redis do barramento de eventos (pub/sub do SSE). Obrigatório em todos os ambientes.
REDIS_URL=redis://127.0.0.1:6379
# Conexão de sessão para o LISTEN do fallback; vazio usa MIGRATE_DATABASE_URL.
# DATABASE_URL_ESCUTA=
# Segredo do agendador que chama POST /api/tarefas/expurgo (Vercel Cron envia como Bearer).
# CRON_SECRET=
APP_URL=http://localhost:5173
# Origens adicionais para CORS (separadas por vírgula)
APP_ORIGINS=
# Diretório do build da SPA servido pela API. Um caminho inexistente (ex.: /tmp/sem-spa)
# desativa a SPA na API, como no perfil serverless em que a Vercel serve o frontend.
WEB_DIST=../web/dist

# Frontend (lido pelo Vite na raiz do repositório)
# Vazio usa a mesma origem da API; defina ao hospedar a SPA em outro host.
# VITE_API_URL=http://localhost:3001

# Autenticação própria: pepper dos códigos de redefinição (mínimo 32 caracteres em produção)
AUTH_PEPPER=troque-por-um-segredo-longo-e-aleatorio

# Cookies de sessão
SESSAO_COOKIE=buscapp_sessao
COOKIE_SAMESITE=lax
# Por padrão o cookie é Secure quando NODE_ENV=production; use para forçar ou desligar.
# COOKIE_SECURE=true

# Armazenamento de anexos: disco (padrão) ou s3
STORAGE_DRIVER=disco
UPLOAD_DIR=uploads
# No Supabase Storage, prefira um bucket com underscore no nome (ex.: buscapp_anexos):
# o endpoint S3 gera URLs pré-assinadas no formato path-style e evita erro de CORS.
# S3_BUCKET=buscapp_anexos
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Validade da URL pré-assinada do upload direto (segundos)
# S3_UPLOAD_URL_EXPIRA_S=300

# Perfil serverless (Vercel)
# Atrás de proxy (Vercel/Fluid), habilita o IP real do cliente em `pedido.ip`.
# TRUST_PROXY=true
# Conexões por instância do pool `pg` (use 1 ou 2 em serverless)
# DB_POOL_MAX=1
# Limite do upload direto via URL pré-assinada
# UPLOAD_DIRETO_MAX_BYTES=20971520
# Re-encode de imagens no servidor: remove EXIF e limita o lado a 1600 px
# PROCESSAR_IMAGENS=true

# Seed de desenvolvimento
# SEED=true no Compose popula o banco na partida do container.
# SEED=false
SEED_SENHA_ADMIN=Admin123!
SEED_SENHA_PROF=Prof123!
SEED_SENHA_RESP=Resp123!
