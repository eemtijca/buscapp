# Banco de dados da API (PostgreSQL).
# Runtime usa o papel restrito `buscapp_api` (sujeito ao RLS); migrações usam o dono do schema.
# Docker Compose (container app):
#   DATABASE_URL=postgresql://buscapp_api:buscapp_api@postgres:5432/buscapp
#   MIGRATE_DATABASE_URL=postgresql://buscapp:buscapp@postgres:5432/buscapp
DATABASE_URL=postgresql://buscapp_api:buscapp_api@127.0.0.1:5433/buscapp
MIGRATE_DATABASE_URL=postgresql://buscapp:buscapp@127.0.0.1:5433/buscapp

# Fixtures/limpeza dos testes (dono do schema, bypassa RLS; nunca use no runtime)
DATABASE_URL_ADMIN=postgresql://buscapp:buscapp@127.0.0.1:5433/buscapp

# Senha do papel de runtime (aplicada pelo entrypoint/Compose)
APP_DB_PASSWORD=buscapp_api

# API
PORT=3001
HOST=0.0.0.0
APP_URL=http://localhost:5173
# Origens adicionais para CORS (separadas por vírgula)
APP_ORIGINS=
WEB_DIST=../web/dist

# Autenticação própria: pepper dos códigos de redefinição (mínimo 32 caracteres em produção)
AUTH_PEPPER=troque-por-um-segredo-longo-e-aleatorio

# Cookies de sessão
SESSAO_COOKIE=buscapp_sessao
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Armazenamento de anexos: disco (padrão) ou s3
STORAGE_DRIVER=disco
UPLOAD_DIR=uploads
# S3_BUCKET=buscapp-anexos
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Seed de desenvolvimento
SEED_SENHA_ADMIN=Admin123!
SEED_SENHA_PROF=Prof123!
SEED_SENHA_RESP=Resp123!
