{
  "name": "@buscapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @buscapp/contratos run build && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "type-check": "pnpm --filter @buscapp/contratos run build && prisma generate && tsc --noEmit",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx prisma/seeds/dev.ts",
    "seed:prod": "node dist/prisma/seeds/dev.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@buscapp/contratos": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "^3.11.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.1.0"
  }
}
