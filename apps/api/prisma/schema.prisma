model anexos {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storage_path         String                 @unique(map: "uq_anexos_storage_path")
  nome_arquivo         String
  mime_type            String
  tamanho_bytes        Int
  criado_por           String?                @db.Uuid
  expurgo_em           DateTime               @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  expurgado_em         DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  processado_em        DateTime?              @db.Timestamptz(6)
  perfis               perfis?                @relation(fields: [criado_por], references: [id], onUpdate: NoAction)
  justificativa_anexos justificativa_anexos[]
  ocorrencia_anexos    ocorrencia_anexos[]

  @@index([expurgo_em], map: "idx_anexos_expurgo", where: raw("(expurgado_em IS NULL)"))
}

