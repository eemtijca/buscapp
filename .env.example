# Banco de dados da API (PostgreSQL). Em Docker Compose, o container sobrescreve este valor.
# Local com Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API
PORT=3001
HOST=0.0.0.0
APP_URL=http://localhost:5173
APP_ORIGINS=
WEB_DIST=../web/dist

# Integração temporária com o Supabase durante a migração (removida na Fase 6)
VITE_SUPABASE_URL=sua_url_do_supabase
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel_do_supabase

SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_do_supabase
SEED_SENHA_ADMIN=Admin123!
SEED_SENHA_PROF=Prof123!
SEED_SENHA_RESP=Resp123!
