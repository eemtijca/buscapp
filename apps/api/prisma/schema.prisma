/// Sessões próprias de autenticação; o token opaco só existe no cookie do navegador,
/// o banco guarda apenas o hash SHA-256.
model sessoes {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  perfil_id     String    @db.Uuid
  token_hash    String    @unique(map: "uq_sessoes_token_hash")
  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  expira_em     DateTime  @db.Timestamptz(6)
  ultimo_uso_em DateTime? @db.Timestamptz(6)
  revogada_em   DateTime? @db.Timestamptz(6)
  user_agent    String?
  ip            String?   @db.Inet
  perfis        perfis    @relation(fields: [perfil_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([perfil_id], map: "idx_sessoes_perfil")
  @@index([expira_em], map: "idx_sessoes_expira")
}

