# Exemplo do modo local com o emulador Floci. Use com:
# terraform apply -var-file=terraform.tfvars.local

modo_local              = true
ambiente                = "local"
imagem_aplicacao        = "buscapp-api:local"
habilitar_nat           = false
multi_az_banco          = false
num_nos_cache           = 1
desired_count           = 1
cpu_tarefa              = 256
memoria_tarefa          = 512
retencao_logs_dias      = 1
habilitar_alarmes       = false
redis_url_local         = "redis://localhost:6379"
