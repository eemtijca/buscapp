generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alunos {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                     String
  matricula                String                    @unique(map: "uq_aluno_matricula")
  codigo_inep              String?
  status                   status_aluno              @default(ativo)
  observacoes              String?
  data_nascimento          DateTime?                 @db.Date
  data_matricula           DateTime?                 @db.Date
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @default(now()) @db.Timestamptz(6)
  transporte_escolar       Boolean                   @default(false)
  alimentacao_diferenciada Boolean                   @default(false)
  necessidades_especiais   Boolean                   @default(false)
  documentos_recebidos     String[]                  @default([])
  conversas                conversas[]
  enturmacoes              enturmacoes[]
  frequencias              frequencias[]
  justificativas_faltas    justificativas_faltas[]
  monitoramento_acoes      monitoramento_acoes[]
  ocorrencias              ocorrencias[]
  registros_comportamento  registros_comportamento[]
  vinculos_responsaveis    vinculos_responsaveis[]

  @@index([matricula], map: "idx_alunos_matricula")
  @@index([nome(ops: raw("gin_trgm_ops"))], map: "idx_alunos_nome_trgm", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
